{
  "name": "localai-nexus",
  "version": "1.1.1",
  "description": "Local AI orchestration hub for projects, prompts, safety checks, logs, and shared memory",
  "main": "dist-electron/main/index.js",
  "author": "LocalAI Nexus",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "dev:web": "vite --mode web --host 127.0.0.1 --port 5173",
    "build": "vite build && tsc --noEmit -p tsconfig.node.json",
    "build:web": "vite build --mode web",
    "fallback:web": "npm run dev:web",
    "fallback:static": "node scripts/static-server.js static-app 4173",
    "dist": "npm run build && electron-builder",
    "preview": "vite preview",
    "preview:web": "vite preview --host 127.0.0.1 --port 4173",
    "serve:static": "node scripts/static-server.js static-app 4173",
    "test": "vitest run --config vite.config.ts",
    "test:watch": "vitest --config vite.config.ts",
    "test:e2e": "node scripts/run-playwright-e2e.js",
    "test:electron-startup": "node scripts/electron-startup-smoke.js",
    "test:electron-auth-bridge": "node scripts/electron-auth-bridge-smoke.js",
    "test:launch-static": "node scripts/launch-static-test.js",
    "test:static-browser": "node scripts/static-browser-smoke.js",
    "test:long-run": "node scripts/long-run-stability-test.js",
    "test:gateway-http": "node scripts/gateway-http-smoke.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src/ tests/ --ext .ts,.tsx --max-warnings 50",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\"",
    "icon": "node scripts/create-icon.js",
    "shortcut": "powershell -ExecutionPolicy Bypass -File scripts/create-shortcut.ps1",
    "shortcut:web": "powershell -ExecutionPolicy Bypass -File scripts/create-shortcut-web.ps1",
    "smoke": "node scripts/smoke-test.js",
    "scan:mojibake": "node scripts/mojibake-scan.js",
    "verify": "node scripts/verify-build.js && npm run smoke",
    "release": "npm run verify && npm run build && npm run dist"
  },
  "build": {
    "appId": "app.localai.nexus",
    "productName": "LocalAI Nexus",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "assets/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/localai-nexus.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "extraResources": [
      {
        "from": "data/",
        "to": "data/",
        "filter": ["**/*"]
      }
    ]
  },
  "dependencies": {
    "simple-git": "^3.27.0",
    "echarts": "^5.6.0",
    "lucide-react": "^0.487.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "uuid": "^11.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.0",
    "eslint": "^8.57.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "playwright": "^1.49.0",
    "postcss": "^8.4.49",
    "prettier": "^3.4.0",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^2.1.0"
  }
}
